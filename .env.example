# Sao chép file này thành .env rồi sửa theo ý bạn.

# --- Bộ não AI (Claude) ---
# Lấy key tại https://console.anthropic.com. Bỏ trống -> chạy chế độ offline (bộ luật).
ANTHROPIC_API_KEY=
# auto | claude | rules
LUCIFER_BRAIN=auto
# Model mặc định; muốn phản hồi nhanh & rẻ hơn có thể đổi sang claude-sonnet-5-5 hoặc claude-haiku-5-5
LUCIFER_MODEL=claude-opus-5-5
# low | medium | high  (low = nhanh nhất, hợp với trợ lý giọng nói)
LUCIFER_EFFORT=low

# --- Tên & từ đánh thức ---
LUCIFER_NAME=Lucifer
# Danh sách cách nhau bằng dấu phẩy, viết không dấu cũng được. Bỏ trống = mặc định (Lucifer, Ê PC...)
LUCIFER_WAKE_WORDS=
# Sau khi trả lời, nghe tiếp bao nhiêu giây mà không cần gọi tên lại
LUCIFER_FOLLOW_UP=15

# --- Nghe ---
# google (online, miễn phí, tiếng Việt tốt) | whisper (offline, cần requirements-whisper.txt)
LUCIFER_STT=google
LUCIFER_LANGUAGE=vi-VN
# tiny | base | small | medium | large-v3  (lớn hơn = chính xác hơn nhưng chậm hơn)
LUCIFER_WHISPER_MODEL=small

# --- Nói ---
# edge (online, giọng Việt tự nhiên) | pyttsx3 (offline) | none
LUCIFER_TTS=edge
# Giọng nam: vi-VN-NamMinhNeural, giọng nữ: vi-VN-HoaiMyNeural
LUCIFER_VOICE=vi-VN-NamMinhNeural
